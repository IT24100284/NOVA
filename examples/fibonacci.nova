fn fib(n: Int) -> Int {
    if n <= 1 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn main(rt: Runtime) -> Int ! {Clock, Runtime} {
    let c = rt.clock();
    let start = c.now();

    let a = fib(10);
    let b = fib(12);
    let c1 = fib(14);

    let end = c.now();
    rt.print("fib(10) =");
    rt.print(a + 0);
    rt.print("fib(12) =");
    rt.print(b + 0);
    rt.print("fib(14) =");
    rt.print(c1 + 0);
    rt.print("elapsed_ms =");
    rt.print(end - start);
    0
}
